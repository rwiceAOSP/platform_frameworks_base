<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Advanced restart menu -->
    <!-- Button to indicate more options -->
    <string name="global_action_restart_more">More</string>
    <!-- Button to restart the device, within the Restart Options dialog -->
    <string name="global_action_restart_system">System</string>
    <!-- Button to restart the device into recovery mode, within the Restart Options dialog -->
    <string name="global_action_restart_recovery">Recovery</string>
    <!-- Button to restart the device into bootloader mode, within the Restart Options dialog -->
    <string name="global_action_restart_bootloader">Bootloader</string>
    <!-- Button to restart the device into download mode, within the Restart Options dialog -->
    <string name="global_action_restart_download">Download</string>
    <!-- Button to restart SystemUI, within the Restart Options dialog -->
    <string name="global_action_restart_systemui">SystemUI</string>

    <!-- Tiered Low Battery Warnings (SystemUIGoogle) -->
    <!-- Low battery notification text when Flipendo (Extreme Battery Saver) is available. [CHAR LIMIT=NONE]-->
    <string name="low_battery_notification_text_ebs">Turn on Extreme Battery Saver. This will pause non-essential apps and their notifications.</string>
    <!-- Title of the severe low battery notification. [CHAR LIMIT=NONE]-->
    <string name="severe_battery_notification_title">%s battery left</string>
    <!-- Text of the severe low battery notification when Battery Saver is not on yet. [CHAR LIMIT=NONE]-->
    <string name="severe_battery_notification_text">Turn on Extreme Battery Saver. This will pause all non-essential apps</string>
    <!-- Text of the severe low battery notification shown when Battery Saver is already on or scheduled, offering to switch to Extreme Battery Saver. [CHAR LIMIT=NONE]-->
    <string name="severe_battery_notification_switch_text">Switch to Extreme Battery Saver?\n\nThis will pause all non-essential apps and their notifications</string>
    <!-- Notification action that switches to Extreme Battery Saver [CHAR LIMIT=30] -->
    <string name="severe_low_battery_dialog_switch_action_text">Switch</string>
    <!-- Title of the extreme low battery notification, shown right before the device shuts down due to critically low battery. [CHAR LIMIT=NONE]-->
    <string name="extreme_low_battery_notification_title">Very low battery</string>
    <!-- Text of the extreme low battery notification. [CHAR LIMIT=NONE]-->
    <string name="extreme_low_battery_notification_text">Your phone will shut down if it\u2019s not charged soon</string>
</resources>
